# Path to your local documents folder (absolute or relative to rag-layer/)
DOCS_FOLDER=./sample-docs

# Path to your models folder (must contain the GGUF file)
MODELS_FOLDER=./models

# The GGUF model filename inside MODELS_FOLDER
# Download from: https://huggingface.co/google/gemma-3-4b-it-qat-q4_0-gguf
GEMMA_MODEL_FILE=gemma-3-4b-it-q4_0.gguf
