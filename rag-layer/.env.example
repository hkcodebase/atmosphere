# Path to your local documents folder (absolute or relative to rag-layer/)
DOCS_FOLDER=./sample-docs

# Docker Model Runner model name — pulled automatically on first run.
# Browse available models: https://hub.docker.com/catalogs/models
# Examples:
#   ai/gemma3:4B-Q4_K_M      (default, ~2.5 GB, CPU-friendly)
#   ai/gemma3:12B-Q4_K_M     (better quality, needs more RAM)
#   ai/mistral:7B-Q4_K_M
GEMMA_MODEL=ai/gemma3:4B-Q4_K_M
